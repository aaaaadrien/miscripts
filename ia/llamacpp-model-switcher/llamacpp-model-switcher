def render_status_fragment():
    status = get_service_status()
    state = status["active_state"]
    if state == "active":
        pill_class, pill_label = "pill-active", "ACTIF"
    elif state == "failed":
        pill_class, pill_label = "pill-failed", "EN ÉCHEC"
    else:
        pill_class, pill_label = "pill-inactive", state.upper()

    rows = [
        ("État du service", f'<span class="pill {pill_class}">{html.escape(pill_label)}</span>'),
        ("Démarrage au boot", html.escape(status["enabled_state"])),
        ("Actif depuis", html.escape(status["active_since_human"] or "—")),
        ("Serveur à l'écoute depuis",
         html.escape(status["listening_since_human"] or "en attente / non détecté")),
    ]
    if status["listening_url"]:
        rows.append(("Adresse détectée", html.escape(status["listening_url"])))

    dts = "".join(f"<dt>{k}</dt><dd>{v}</dd>" for k, v in rows)
    return f'<h2>Statut du service</h2><dl class="status-grid">{dts}</dl>'


def render_page(message_html=""):
    try:
        configs = read_configs()
    except Exception as e:
        message_html = f'<div class="card"><p class="msg-err">Erreur de lecture du fichier : {html.escape(str(e))}</p></div>'
        configs = []

    if not configs:
        rows_html = '<p class="msg-err">Aucune configuration enregistrée. Ajoutez-en une ci-dessous.</p>'
    else:
        rows = []
        for idx, c in enumerate(configs):
            rows.append(ROW_TEMPLATE.format(
                active_class=" active" if c["active"] else "",
                idx=idx,
                checked="checked" if c["active"] else "",
                name=html.escape(c["name"]),
                badge='<span class="badge">ACTIF</span>' if c["active"] else "",
                command=html.escape(c["command"]),
            ))
        rows_html = "\n".join(rows)

    return PAGE_TEMPLATE.format(
        style=STYLE,
        service_file=html.escape(SERVICE_FILE),
        message_block=message_html,
        status_fragment=render_status_fragment(),
        rows=rows_html,
    )


