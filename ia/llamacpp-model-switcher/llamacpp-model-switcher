        idx=idx,
        name=html.escape(cfg["name"]),
        command=html.escape(cfg["command"]),
    )


def msg_block(ok, text):
    cls = "msg-ok" if ok else "msg-err"
    return f'<div class="card"><pre class="{cls}">{html.escape(text)}</pre></div>'


# --------------------------------------------------------------------------
# Serveur HTTP
# --------------------------------------------------------------------------

class Handler(BaseHTTPRequestHandler):
    def log_message(self, fmt, *args):
        sys.stderr.write("%s - %s\n" % (self.address_string(), fmt % args))

    def _send_html(self, body, status=200):
        encoded = body.encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(encoded)))
        self.end_headers()
        self.wfile.write(encoded)

    def _read_form(self):
        length = int(self.headers.get("Content-Length", 0))
        body = self.rfile.read(length).decode("utf-8")
        return parse_qs(body)

    def do_GET(self):
        parsed = urlparse(self.path)
        if parsed.path in ("/", "/index.html"):
            self._send_html(render_page())
        elif parsed.path == "/status":
            self._send_html(render_status_fragment())
        elif parsed.path == "/edit":
            qs = parse_qs(parsed.query)
            idx_raw = qs.get("idx", [None])[0]
            try:
                idx = int(idx_raw)
                configs = read_configs()
                cfg = configs[idx] if 0 <= idx < len(configs) else None
            except (TypeError, ValueError):
                cfg = None
            if cfg is None:
                self._send_html(render_page(msg_block(False, "Configuration introuvable.")))
            else:
                self._send_html(render_edit_page(idx, cfg))
        else:
            self._send_html("<h1>404</h1>", status=404)

    def do_POST(self):
        parsed = urlparse(self.path)
        params = self._read_form()

        def first(key, default=""):
            return params.get(key, [default])[0]

        def first_idx():
            raw = first("idx")
            return int(raw) if raw.isdigit() else -1

        try:
            if parsed.path == "/activate":
                ok, text = action_activate(first_idx())
                self._send_html(render_page(msg_block(ok, text)))

            elif parsed.path == "/add":
                ok, text = action_add(first("name"), first("command"))
                self._send_html(render_page(msg_block(ok, text)))

            elif parsed.path == "/edit":
                ok, text = action_edit(first_idx(), first("name"), first("command"))
                self._send_html(render_page(msg_block(ok, text)))

            elif parsed.path == "/delete":
                raw = first("delete_idx")
                idx = int(raw) if raw.isdigit() else -1
                ok, text = action_delete(idx)
                self._send_html(render_page(msg_block(ok, text)))

            else:
                self._send_html("<h1>404</h1>", status=404)
        except Exception as e:
            self._send_html(render_page(msg_block(False, f"Erreur inattendue : {e}")))


def main():
    warn_if_root()
    try:
        normalize_if_needed()
    except Exception as e:
        print(f"Avertissement : normalisation initiale échouée : {e}", file=sys.stderr)

    server = HTTPServer((HOST, PORT), Handler)
    print(f"Serveur lancé sur http://{HOST}:{PORT} (Ctrl+C pour arrêter)")
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nArrêt du serveur.")
        server.server_close()


if __name__ == "__main__":
    main()
